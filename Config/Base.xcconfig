// RainPulse build settings — shared by the app and the widget.
// 1) Change BUNDLE_ID_BASE to your own reverse-domain ID (must match App Store Connect).
// 2) Set DEVELOPMENT_TEAM to your 10-character Apple Team ID.
// 3) Put API keys in Config/Secrets.xcconfig (not committed) or as Xcode Cloud
//    environment variables (ci_scripts/ci_post_clone.sh writes the file for you).

BUNDLE_ID_BASE = com.neuralorbitx.rainpulse
DEVELOPMENT_TEAM = D62ZJ949AT
APP_GROUP_ID = group.$(BUNDLE_ID_BASE)

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1

// CloudKit environment for "Rain Truth" reports. TestFlight and App Store builds always use
// Production; the Report record type was deployed to Production on 26 Nov 2026. Schema changes
// are made in Development in the CloudKit Console and then deployed to Production.
CLOUDKIT_ENVIRONMENT = Production

// "Rain Truth" needs the iCloud container iCloud.com.neuralorbitx.rainpulse in the developer
// account (created 25 Nov 2026). To switch reports off: RP_CLOUD_REPORTS = NO and
// RP_APP_ENTITLEMENTS = RainPulse
RP_CLOUD_REPORTS = YES
RP_APP_ENTITLEMENTS = RainPulse-iCloud

// API keys (overridden by Secrets.xcconfig)
OWM_API_KEY =
TOMORROW_API_KEY =
OPEN_METEO_API_KEY =

// "//" starts a comment in xcconfig files, hence the $() trick.
PRIVACY_POLICY_URL = https:/$()/winniecherian.github.io/rainpulse/privacy.html

#include? "Secrets.xcconfig"
