    "%lld km from %@ now; forecast track passes about %lld km away.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على بعد %lld كم من %@ الآن؛ يمر المسار المتوقع على بعد نحو %lld كم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt %lld km von %@ entfernt; die Zugbahn führt in etwa %lld km vorbei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A %lld km de %@ ahora; la trayectoria prevista pasa a unos %lld km."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À %lld km de %@ actuellement ; la trajectoire prévue passe à environ %lld km."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी %lld किमी दूर (%@ से); अनुमानित रास्ता लगभग %lld किमी दूर से गुज़रेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld km dari %@ sekarang; lintasan prakiraan lewat sekitar %lld km."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在%lld km（%@から）。予想進路は約%lld kmまで接近します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A %lld km de %@ agora; a trajetória prevista passa a cerca de %lld km."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது %lld கி.மீ தொலைவில் (%@ இலிருந்து); முன்னறிவிப்பு பாதை சுமார் %lld கி.மீ தொலைவில் செல்லும்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách %lld km (từ %@); đường đi dự báo qua cách khoảng %lld km."
          }
        }
      }
    },
