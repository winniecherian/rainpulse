    "Dry for about %lld min. Back before %@ to stay dry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاف لنحو %lld د. عُد قبل %@ لتبقى جافًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %lld Min. trocken. Vor %@ zurück sein, um trocken zu bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seco durante unos %lld min. Vuelve antes de las %@ para no mojarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sec pendant environ %lld min. Rentrez avant %@ pour rester au sec."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग %lld मिनट सूखा रहेगा। भीगने से बचने के लिए %@ से पहले लौटें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kering sekitar %lld mnt. Kembali sebelum %@ agar tidak kehujanan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約%lld分は雨なし。濡れないよう%@までに戻りましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seco por cerca de %lld min. Volte antes das %@ para não se molhar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுமார் %lld நிமி. மழை இல்லை. நனையாமல் இருக்க %@ க்குள் திரும்புங்கள்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khô ráo khoảng %lld phút. Về trước %@ để không bị ướt."
          }
        }
      }
    },
