    "Live rain map, a 2-hour rain forecast and alerts before it starts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خريطة مطر مباشرة، وتوقعات المطر لساعتين، وتنبيهات قبل أن يبدأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Regenkarte, 2-Stunden-Regenvorhersage und Warnung, bevor es losgeht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa de lluvia en vivo, pronóstico de lluvia de 2 horas y alertas antes de que empiece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte de pluie en direct, prévisions de pluie sur 2 h et alertes avant qu'elle ne commence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव बारिश मैप, 2 घंटे का बारिश पूर्वानुमान और शुरू होने से पहले अलर्ट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peta hujan langsung, prakiraan hujan 2 jam, dan peringatan sebelum hujan mulai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ雨雲マップ、2時間の雨予報、降り出す前の通知。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa de chuva ao vivo, previsão de chuva de 2 horas e alertas antes de começar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரலை மழை வரைபடம், 2 மணி நேர மழை முன்னறிவிப்பு, தொடங்கும் முன் எச்சரிக்கை."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản đồ mưa trực tiếp, dự báo mưa 2 giờ và cảnh báo trước khi mưa."
          }
        }
      }
    },
