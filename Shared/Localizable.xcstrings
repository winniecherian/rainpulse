        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くの報告はまだありません。ワンタップで最初の報告を。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há relatos perto de você. Seja o primeiro — é só um toque."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அருகில் இன்னும் அறிக்கைகள் இல்லை. முதலாவதாக இருங்கள் — ஒரே தட்டல் போதும்."
