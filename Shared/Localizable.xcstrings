          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertes avant la pluie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारिश से पहले अलर्ट"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan sebelum hujan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雨の前に通知"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas antes de chover"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மழைக்கு முன் எச்சரிக்கை"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo trước khi mưa"
          }
        }
      }
    },
    "Alerts cover your current location and every saved place with the bell on. iOS decides exactly when background checks run.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل التنبيهات موقعك الحالي وكل مكان محفوظ مفعّل فيه الجرس. يحدد iOS توقيت الفحص في الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnungen gelten für deinen Standort und jeden gespeicherten Ort mit aktivierter Glocke. iOS entscheidet, wann Hintergrundprüfungen laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas cubren tu ubicación actual y cada lugar guardado con la campana activada. iOS decide cuándo se hacen las comprobaciones en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes couvrent votre position et chaque lieu enregistré avec la cloche activée. iOS décide quand les vérifications en arrière-plan ont lieu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलर्ट आपकी मौजूदा लोकेशन और घंटी चालू वाली हर सेव जगह के लिए हैं। बैकग्राउंड जाँच कब होगी, यह iOS तय करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan mencakup lokasi Anda saat ini dan setiap tempat tersimpan dengan lonceng aktif. iOS menentukan kapan pemeriksaan latar belakang berjalan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は現在地と、ベルをオンにした保存場所が対象です。バックグラウンド確認のタイミングは iOS が決定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas cobrem sua localização atual e cada lugar salvo com o sino ativado. O iOS decide quando as verificações em segundo plano acontecem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எச்சரிக்கைகள் உங்கள் தற்போதைய இருப்பிடத்துக்கும் மணி இயக்கப்பட்ட ஒவ்வொரு சேமித்த இடத்துக்கும் பொருந்தும். பின்னணி சரிபார்ப்பு நேரத்தை iOS முடிவு செய்கிறது."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo áp dụng cho vị trí hiện tại và mọi địa điểm đã lưu có bật chuông. iOS quyết định khi nào kiểm tra nền chạy."
          }
        }
      }
    },
    "All %lld weather models agree: no rain in the next 12 hours.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتفق النماذج الـ%lld كلها: لا مطر خلال الـ12 ساعة القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld Wettermodelle sind sich einig: kein Regen in den nächsten 12 Stunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld modelos coinciden: sin lluvia en las próximas 12 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld modèles sont d'accord : pas de pluie dans les 12 prochaines heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी %lld मौसम मॉडल सहमत: अगले 12 घंटे बारिश नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua %lld model cuaca sepakat: tidak hujan dalam 12 jam ke depan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld つの予報モデルすべてが一致：今後12時間は雨なし。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os %lld modelos concordam: sem chuva nas próximas 12 horas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்து %lld வானிலை மாதிரிகளும் ஒப்புக்கொள்கின்றன: அடுத்த 12 மணி நேரம் மழை இல்லை."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả %lld mô hình đều thống nhất: không mưa trong 12 giờ tới."
          }
        }
      }
    },
    "All %lld weather models show rain, starting around %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُظهر النماذج الـ%lld كلها مطرًا يبدأ نحو %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld Modelle zeigen Regen, ab etwa %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld modelos muestran lluvia, empezando hacia las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld modèles prévoient de la pluie, à partir d'environ %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी %lld मॉडल बारिश दिखाते हैं, लगभग %@ से।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua %lld model menunjukkan hujan, mulai sekitar %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld つのモデルすべてが雨を予想、%@ ごろから。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os %lld modelos mostram chuva, começando por volta das %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்து %lld மாதிரிகளும் மழையைக் காட்டுகின்றன, சுமார் %@ முதல்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả %lld mô hình đều cho thấy mưa, bắt đầu khoảng %@."
          }
        }
      }
    },
