    "See where it's raining right now, anywhere in the world, and where the rain is heading.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد أين تمطر الآن في أي مكان في العالم، وإلى أين يتجه المطر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wo es gerade regnet – überall auf der Welt – und wohin der Regen zieht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira dónde llueve ahora mismo, en cualquier lugar del mundo, y hacia dónde va la lluvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez où il pleut en ce moment, partout dans le monde, et où va la pluie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें अभी दुनिया में कहाँ बारिश हो रही है और बारिश किधर बढ़ रही है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat di mana sedang hujan sekarang, di mana pun di dunia, dan ke mana hujan bergerak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界中のどこで今雨が降っているか、そして雨雲がどこへ向かうかがわかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja onde está chovendo agora, em qualquer lugar do mundo, e para onde a chuva vai."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உலகில் எங்கே இப்போது மழை பெய்கிறது, மழை எங்கே நகர்கிறது என்று பாருங்கள்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nơi đang mưa ngay lúc này ở bất cứ đâu trên thế giới và mưa đang di chuyển đến đâu."
          }
        }
      }
    },
