    "Get a heads-up before rain reaches you, so you can leave early or wait it out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على تنبيه قبل وصول المطر، لتخرج مبكرًا أو تنتظر حتى يمر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine Warnung, bevor der Regen dich erreicht – so kannst du früher los oder abwarten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso antes de que llegue la lluvia para salir antes o esperar a que pase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez prévenu avant l'arrivée de la pluie pour partir plus tôt ou attendre qu'elle passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारिश पहुँचने से पहले अलर्ट पाएँ, ताकि आप जल्दी निकल सकें या रुक सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan peringatan sebelum hujan tiba, agar bisa berangkat lebih awal atau menunggu reda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雨が来る前に通知。早めに出発するか、やむまで待つか決められます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba um aviso antes de a chuva chegar, para sair antes ou esperar passar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மழை வருவதற்கு முன் எச்சரிக்கை பெறுங்கள்; சீக்கிரம் கிளம்பலாம் அல்லது காத்திருக்கலாம்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận cảnh báo trước khi mưa đến để đi sớm hoặc chờ mưa tạnh."
          }
        }
      }
    },
