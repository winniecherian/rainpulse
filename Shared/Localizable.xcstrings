    "Carry an umbrella — rain is most likely around %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احمل مظلة — المطر مرجح أكثر حوالي %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Schirm mit – Regen ist um %@ am wahrscheinlichsten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva paraguas: lo más probable es que llueva hacia las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez un parapluie : la pluie est la plus probable vers %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छाता साथ रखें — बारिश की सबसे ज़्यादा संभावना %@ के आसपास है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawa payung — hujan paling mungkin sekitar %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傘を持って行きましょう。%@ごろに雨の可能性が最も高いです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve guarda-chuva: a chuva é mais provável por volta das %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குடை எடுத்துச் செல்லுங்கள் — %@ அளவில் மழைக்கு அதிக வாய்ப்பு."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mang ô theo — khả năng mưa cao nhất vào khoảng %@."
          }
        }
      }
    },
