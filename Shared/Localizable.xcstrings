    "No reports near you yet. Be the first — it takes one tap.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا بلاغات قربك بعد. كن الأول — بنقرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Meldungen in deiner Nähe. Sei der Erste – ein Tipp genügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay reportes cerca. Sé el primero: solo un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signalement près de vous. Soyez le premier — un seul geste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास अभी कोई रिपोर्ट नहीं। पहले बनें — बस एक टैप।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada laporan di dekat Anda. Jadilah yang pertama — cukup satu ketukan."
