    "Free: alerts for your current location. Essential and Pro: alerts for all saved places.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاني: تنبيهات لموقعك الحالي. Essential وPro: تنبيهات لكل الأماكن المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos: Warnungen für deinen Standort. Essential und Pro: Warnungen für alle gespeicherten Orte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis: alertas para tu ubicación actual. Essential y Pro: alertas para todos los lugares guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit : alertes pour votre position. Essential et Pro : alertes pour tous les lieux enregistrés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त: आपकी मौजूदा लोकेशन के अलर्ट। Essential और Pro: सभी सेव जगहों के अलर्ट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis: peringatan untuk lokasi Anda saat ini. Essential dan Pro: peringatan untuk semua tempat tersimpan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料：現在地の通知。Essential と Pro：すべての保存場所の通知。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis: alertas para sua localização atual. Essential e Pro: alertas para todos os lugares salvos."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இலவசம்: தற்போதைய இருப்பிடத்துக்கு எச்சரிக்கை. Essential, Pro: எல்லா சேமித்த இடங்களுக்கும்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miễn phí: cảnh báo cho vị trí hiện tại. Essential và Pro: cảnh báo cho mọi địa điểm đã lưu."
          }
        }
      }
    },
