    "Rain alerts always cover your current location.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل تنبيهات المطر دائمًا موقعك الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenwarnungen gelten immer für deinen aktuellen Standort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas de lluvia siempre cubren tu ubicación actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes pluie couvrent toujours votre position actuelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारिश अलर्ट हमेशा आपकी मौजूदा लोकेशन के लिए चालू रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan hujan selalu mencakup lokasi Anda saat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雨の通知は常に現在地が対象です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas de chuva sempre cobrem sua localização atual."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மழை எச்சரிக்கைகள் எப்போதும் உங்கள் தற்போதைய இருப்பிடத்தை உள்ளடக்கும்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo mưa luôn áp dụng cho vị trí hiện tại của bạn."
          }
        }
      }
    },
