          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld signalements d'inondation près de %@. Dernier il y a %lld min — envisagez un autre itinéraire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld जलभराव रिपोर्ट %@ के पास। ताज़ा %lld मिनट पहले — दूसरा रास्ता चुनें।"
