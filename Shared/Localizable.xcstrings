    "Waterlogging reported near %@ %lld min ago — consider another route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإبلاغ عن تجمع المياه قرب %@ قبل %lld د — فكّر في طريق آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überflutung bei %@ gemeldet, vor %lld Min. — nimm besser eine andere Route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inundación reportada cerca de %@ hace %lld min: considera otra ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inondation signalée près de %@ il y a %lld min — envisagez un autre itinéraire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के पास जलभराव की सूचना, %lld मिनट पहले — दूसरा रास्ता चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Genangan dilaporkan di dekat %@ %lld mnt lalu — pertimbangkan rute lain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@付近で冠水の報告（%lld分前）— 別のルートをご検討ください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alagamento relatado perto de %@ há %lld min — considere outra rota."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
