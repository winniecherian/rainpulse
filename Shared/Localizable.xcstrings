    "%lld of %lld weather models show no rain in the next 12 hours; %lld show some.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld من %lld نماذج لا تُظهر مطرًا خلال الـ12 ساعة القادمة؛ و%lld تُظهر بعضه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld Modellen zeigen keinen Regen in den nächsten 12 Stunden; %lld zeigen etwas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld modelos no muestran lluvia en las próximas 12 horas; %lld muestran algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld modèles sur %lld ne prévoient pas de pluie dans les 12 prochaines heures ; %lld en prévoient un peu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld में से %lld मॉडल अगले 12 घंटे बारिश नहीं दिखाते; %lld कुछ बारिश दिखाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dari %lld model tidak menunjukkan hujan dalam 12 jam ke depan; %lld menunjukkan sedikit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld のモデルは今後12時間雨なし、%lld つは多少の雨を予想。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld modelos não mostram chuva nas próximas 12 horas; %lld mostram alguma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld மாதிரிகள் அடுத்த 12 மணி நேரம் மழை இல்லை எனக் காட்டுகின்றன; %lld சிறிது மழை காட்டுகின்றன."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld trên %lld mô hình không thấy mưa trong 12 giờ tới; %lld cho thấy có mưa."
          }
        }
      }
    },
    "%lld of %lld weather models show rain, but disagree on timing: between %@ and %@.": {
