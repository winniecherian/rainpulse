          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "der Regenvorhersagen lagen hier in den letzten 7 Tagen richtig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "de los pronósticos de lluvia acertaron aquí en los últimos 7 días"
          }
        },
        "fr": {
