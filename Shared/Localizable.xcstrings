    "Thanks! You can send another report in a few minutes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا! يمكنك إرسال بلاغ آخر بعد بضع دقائق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke! In ein paar Minuten kannst du erneut melden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias! Podrás enviar otro reporte en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci ! Vous pourrez envoyer un autre signalement dans quelques minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद! आप कुछ मिनट में दूसरी रिपोर्ट भेज सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih! Anda bisa mengirim laporan lagi dalam beberapa menit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます！数分後にまた報告できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado! Você poderá enviar outro relato em alguns minutos."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நன்றி! சில நிமிடங்களில் மீண்டும் அறிக்கை அனுப்பலாம்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn! Bạn có thể gửi báo cáo khác sau vài phút."
          }
        }
      }
    },
    "Thanks! Your report is on the map.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا! بلاغك على الخريطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke! Deine Meldung ist auf der Karte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias! Tu reporte ya está en el mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci ! Votre signalement est sur la carte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद! आपकी रिपोर्ट मैप पर है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih! Laporan Anda sudah ada di peta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます！報告が地図に表示されました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado! Seu relato está no mapa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நன்றி! உங்கள் அறிக்கை வரைபடத்தில் உள்ளது."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn! Báo cáo của bạn đã có trên bản đồ."
          }
        }
      }
    },
    "The agency's own wording. Follow local authorities' instructions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص الجهة الأصلي. اتبع تعليمات السلطات المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originaltext der Behörde. Folge den Anweisungen der örtlichen Behörden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto original de la agencia. Sigue las indicaciones de las autoridades locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte original de l'organisme. Suivez les consignes des autorités locales."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंसी के अपने शब्द। स्थानीय अधिकारियों के निर्देशों का पालन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata asli dari lembaga. Ikuti petunjuk otoritas setempat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発表機関の原文です。地元当局の指示に従ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto original da agência. Siga as instruções das autoridades locais."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிறுவனத்தின் சொந்த வார்த்தைகள். உள்ளூர் அதிகாரிகளின் அறிவுறுத்தல்களைப் பின்பற்றுங்கள்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguyên văn của cơ quan ban hành. Hãy làm theo hướng dẫn của chính quyền địa phương."
          }
        }
      }
    },
