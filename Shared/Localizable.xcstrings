    "%@, winds up to %lld km/h, %lld km away. Follow official warnings from your weather service.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، رياح تصل إلى %lld كم/س، على بعد %lld كم. اتبع التحذيرات الرسمية لهيئة الأرصاد لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, Wind bis %lld km/h, %lld km entfernt. Folge den offiziellen Warnungen deines Wetterdienstes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, vientos de hasta %lld km/h, a %lld km. Sigue los avisos oficiales de tu servicio meteorológico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, vents jusqu'à %lld km/h, à %lld km. Suivez les alertes officielles de votre service météo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %lld किमी/घंटा तक की हवाएँ, %lld किमी दूर। अपनी मौसम सेवा की आधिकारिक चेतावनियों का पालन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, angin hingga %lld km/jam, %lld km jauhnya. Ikuti peringatan resmi dari layanan cuaca Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、最大風速 %lld km/h、%lld km先。気象機関の公式警報に従ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ventos de até %lld km/h, a %lld km. Siga os alertas oficiais do seu serviço meteorológico."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %lld கி.மீ/ம வரை காற்று, %lld கி.மீ தொலைவில். உங்கள் வானிலை மையத்தின் அதிகாரப்பூர்வ எச்சரிக்கைகளைப் பின்பற்றுங்கள்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, gió đến %lld km/h, cách %lld km. Hãy theo dõi cảnh báo chính thức của cơ quan khí tượng."
          }
        }
      }
    },
