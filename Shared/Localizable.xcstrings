    "Weather models disagree: %lld of %lld show rain in the next 12 hours.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النماذج غير متفقة: %lld من %lld تُظهر مطرًا خلال الـ12 ساعة القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wettermodelle sind uneins: %lld von %lld zeigen Regen in den nächsten 12 Stunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos no coinciden: %lld de %lld muestran lluvia en las próximas 12 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles ne sont pas d'accord : %lld sur %lld prévoient de la pluie dans les 12 prochaines heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौसम मॉडल असहमत हैं: %lld में से %lld अगले 12 घंटे में बारिश दिखाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model cuaca tidak sepakat: %lld dari %lld menunjukkan hujan dalam 12 jam ke depan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報モデルの見解が分かれています：%lld / %lld が今後12時間に雨を予想。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos discordam: %lld de %lld mostram chuva nas próximas 12 horas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வானிலை மாதிரிகள் ஒத்துப்போகவில்லை: %lld / %lld அடுத்த 12 மணி நேரத்தில் மழையைக் காட்டுகின்றன."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mô hình không thống nhất: %lld trên %lld cho thấy mưa trong 12 giờ tới."
          }
        }
      }
    },
    "Weather services get your location rounded to about 1 km": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلقى خدمات الطقس موقعك مقربًا إلى نحو 1 كم"
