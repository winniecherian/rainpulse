    "RainPulse is keeping score here. Each forecast is checked against what really happened — results appear within a day.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل RainPulse النتائج هنا. تُقارن كل توقعات بما حدث فعلًا — تظهر النتائج خلال يوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RainPulse führt hier Buch. Jede Vorhersage wird mit dem tatsächlichen Wetter verglichen – Ergebnisse erscheinen innerhalb eines Tages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RainPulse lleva la cuenta aquí. Cada pronóstico se compara con lo que pasó de verdad; los resultados aparecen en un día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RainPulse tient les comptes ici. Chaque prévision est comparée à ce qui s'est vraiment passé — résultats sous un jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "RainPulse यहाँ हिसाब रख रहा है। हर पूर्वानुमान की तुलना असल में हुए मौसम से होती है — नतीजे एक दिन में दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "RainPulse sedang mencatat di sini. Setiap prakiraan dicek dengan kejadian sebenarnya — hasil muncul dalam sehari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RainPulse がこの地点の成績を記録中です。各予報を実際の天気と照合し、1日以内に結果が表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RainPulse está registrando aqui. Cada previsão é comparada com o que realmente aconteceu — os resultados aparecem em um dia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "RainPulse இங்கே மதிப்பெண் வைத்துக்கொண்டிருக்கிறது. ஒவ்வொரு முன்னறிவிப்பும் உண்மையில் நடந்ததோடு ஒப்பிடப்படுகிறது — முடிவுகள் ஒரு நாளில் தெரியும்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "RainPulse đang ghi điểm tại đây. Mỗi dự báo được so với thực tế — kết quả hiện trong vòng một ngày."
          }
        }
      }
    },
