    "Allow location": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالموقع"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir ubicación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser la localisation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकेशन की अनुमति दें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan lokasi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を許可"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir localização"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருப்பிடத்தை அனுமதி"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép vị trí"
          }
        }
      }
    },
    "Allow location access or add a place to see the forecast.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الموقع أو أضف مكانًا لعرض التوقعات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Standortzugriff oder füge einen Ort hinzu, um die Vorhersage zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la ubicación o añade un lugar para ver el pronóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la localisation ou ajoutez un lieu pour voir les prévisions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्वानुमान देखने के लिए लोकेशन की अनुमति दें या कोई जगह जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses lokasi atau tambahkan tempat untuk melihat prakiraan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報を見るには位置情報を許可するか、場所を追加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à localização ou adicione um lugar para ver a previsão."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முன்னறிவிப்பைக் காண இருப்பிட அனுமதி கொடுங்கள் அல்லது ஒரு இடத்தைச் சேர்க்கவும்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập vị trí hoặc thêm địa điểm để xem dự báo."
          }
        }
      }
    },
    "Allow location so RainPulse can show the rain map and forecast around you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الموقع ليعرض RainPulse خريطة المطر والتوقعات من حولك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Standort, damit RainPulse Regenkarte und Vorhersage in deiner Nähe zeigen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la ubicación para que RainPulse muestre el mapa de lluvia y el pronóstico a tu alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la localisation pour que RainPulse affiche la carte de pluie et les prévisions autour de vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकेशन की अनुमति दें ताकि RainPulse आपके आसपास का बारिश मैप और पूर्वानुमान दिखा सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan lokasi agar RainPulse dapat menampilkan peta hujan dan prakiraan di sekitar Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を許可すると、RainPulse が周辺の雨雲マップと予報を表示できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a localização para o RainPulse mostrar o mapa de chuva e a previsão ao seu redor."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களைச் சுற்றியுள்ள மழை வரைபடம், முன்னறிவிப்பைக் காட்ட RainPulse-க்கு இருப்பிட அனுமதி கொடுங்கள்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép vị trí để RainPulse hiển thị bản đồ mưa và dự báo quanh bạn."
          }
        }
      }
    },
    "Always follow official warnings from your national weather service.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتبع دائمًا التحذيرات الرسمية لهيئة الأرصاد الوطنية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge immer den offiziellen Warnungen deines nationalen Wetterdienstes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue siempre los avisos oficiales de tu servicio meteorológico nacional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez toujours les alertes officielles de votre service météo national."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमेशा अपनी राष्ट्रीय मौसम सेवा की आधिकारिक चेतावनियों का पालन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu ikuti peringatan resmi dari badan cuaca nasional Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必ず各国の気象機関の公式警報に従ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga sempre os alertas oficiais do serviço meteorológico do seu país."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தேசிய வானிலை மையத்தின் அதிகாரப்பூர்வ எச்சரிக்கைகளை எப்போதும் பின்பற்றுங்கள்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn theo dõi cảnh báo chính thức của cơ quan khí tượng quốc gia."
          }
        }
      }
    },
