    "Will last more than 1 hour, expected to end at %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيستمر أكثر من ساعة، ويُتوقع أن يتوقف عند %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauert über 1 Stunde, endet voraussichtlich um %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durará más de 1 hora; se espera que pare a las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durera plus d'une heure, fin prévue à %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 घंटे से ज़्यादा चलेगी, %@ तक रुकने की संभावना।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akan berlangsung lebih dari 1 jam, diperkirakan berhenti pukul %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1時間以上続き、%@ごろに止む見込みです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai durar mais de 1 hora; deve parar às %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "1 மணி நேரத்துக்கு மேல் நீடிக்கும், %@ மணிக்கு நிற்கும் என எதிர்பார்க்கப்படுகிறது."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo dài hơn 1 giờ, dự kiến tạnh lúc %@."
          }
        }
      }
    },
