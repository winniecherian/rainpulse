    "Erase saved places, settings, alerts and cached weather on this iPhone?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد مسح الأماكن المحفوظة والإعدادات والتنبيهات وبيانات الطقس المخزنة على هذا الـ iPhone؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Orte, Einstellungen, Warnungen und zwischengespeichertes Wetter auf diesem iPhone löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar lugares guardados, ajustes, alertas y tiempo en caché de este iPhone?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer les lieux enregistrés, réglages, alertes et données météo de cet iPhone ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone से सेव जगहें, सेटिंग्स, अलर्ट और कैश मौसम मिटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus tempat tersimpan, pengaturan, peringatan, dan cache cuaca di iPhone ini?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone の保存場所、設定、通知、キャッシュされた天気を消去しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar lugares salvos, ajustes, alertas e dados de tempo deste iPhone?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த iPhone-இல் சேமித்த இடங்கள், அமைப்புகள், எச்சரிக்கைகள், வானிலைத் தரவை அழிக்கவா?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa địa điểm đã lưu, cài đặt, cảnh báo và dữ liệu thời tiết trên iPhone này?"
          }
        }
      }
    },
