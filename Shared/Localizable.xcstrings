    "Official warnings come from government weather agencies and are free on every plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي التحذيرات الرسمية من وكالات الأرصاد الحكومية وهي مجانية في كل الخطط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Amtliche Warnungen stammen von staatlichen Wetterdiensten und sind in jedem Tarif kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos oficiales vienen de agencias meteorológicas del gobierno y son gratis en todos los planes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes officielles proviennent des services météo gouvernementaux et sont gratuites dans toutes les formules."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आधिकारिक चेतावनियाँ सरकारी मौसम एजेंसियों से आती हैं और हर प्लान में मुफ़्त हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan resmi berasal dari badan cuaca pemerintah dan gratis di semua paket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式警報は政府の気象機関が発表するもので、すべてのプランで無料です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas oficiais vêm de agências meteorológicas do governo e são grátis em todos os planos."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகாரப்பூர்வ எச்சரிக்கைகள் அரசு வானிலை நிறுவனங்களிடமிருந்து வருகின்றன, எல்லா திட்டங்களிலும் இலவசம்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo chính thức đến từ cơ quan khí tượng nhà nước và miễn phí ở mọi gói."
          }
        }
      }
    },
