    "Your subscription stays with your Apple Account and can be restored any time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى اشتراكك مرتبطًا بحساب Apple ويمكن استعادته في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo bleibt in deinem Apple Account und lässt sich jederzeit wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción está vinculada a tu cuenta de Apple y puedes restaurarla cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement reste lié à votre compte Apple et peut être restauré à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सदस्यता आपके Apple अकाउंट से जुड़ी है और कभी भी पुनर्स्थापित की जा सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan Anda tersimpan di Akun Apple dan bisa dipulihkan kapan saja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは Apple アカウントに紐づき、いつでも復元できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura fica na sua conta Apple e pode ser restaurada a qualquer momento."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சந்தா Apple கணக்குடன் இணைந்துள்ளது; எப்போது வேண்டுமானாலும் மீட்டமைக்கலாம்."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký gắn với Tài khoản Apple và có thể khôi phục bất cứ lúc nào."
          }
        }
      }
    },
