    "Four independent weather models, next 12 hours. When they agree, the forecast is more reliable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أربعة نماذج طقس مستقلة، للساعات الـ12 القادمة. عندما تتفق، تكون التوقعات أكثر موثوقية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier unabhängige Wettermodelle, nächste 12 Stunden. Wenn sie übereinstimmen, ist die Vorhersage zuverlässiger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro modelos meteorológicos independientes, próximas 12 horas. Cuando coinciden, el pronóstico es más fiable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre modèles météo indépendants, 12 prochaines heures. Quand ils concordent, la prévision est plus fiable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार स्वतंत्र मौसम मॉडल, अगले 12 घंटे। जब वे सहमत हों, तो पूर्वानुमान ज़्यादा भरोसेमंद होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Empat model cuaca independen, 12 jam ke depan. Jika sepakat, prakiraan lebih dapat diandalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立した4つの予報モデル、今後12時間。一致しているほど予報の信頼性が高まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro modelos meteorológicos independentes, próximas 12 horas. Quando concordam, a previsão é mais confiável."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான்கு தனித்தனி வானிலை மாதிரிகள், அடுத்த 12 மணி நேரம். அவை ஒத்துப்போனால் முன்னறிவிப்பு அதிக நம்பகமானது."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn mô hình thời tiết độc lập, 12 giờ tới. Khi chúng thống nhất, dự báo đáng tin cậy hơn."
          }
        }
      }
    },
